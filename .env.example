# Copy to .env.local for local development. Never commit real values.
# `npm run db:start` fills in the database URLs and local secrets automatically.

# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://gik:password@localhost:5434/gik_dev
# Integration and E2E tests only; the database name must end in _test.
DATABASE_URL_TEST=postgresql://gik:password@localhost:5434/gik_test
# 32+ random characters (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 32+ random characters; IPs are only ever stored as keyed hashes.
IP_HASH_SECRET=

# ── Public site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# International digits, e.g. 97334597636. Empty hides the WhatsApp button (OPEN_QUESTIONS #8).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Scheduled job (/api/cron/outbox) ──────────────────────────────────────
# 24+ random characters; the host's cron sends `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ── Email (Resend). Without these, emails are reported as "not configured". ──
RESEND_API_KEY=
EMAIL_FROM="Global Island Kitchens <noreply@your-domain>"
# Comma-separated staff addresses for new-enquiry notifications (OPEN_QUESTIONS #32).
NOTIFY_EMAILS=

# ── n8n (optional) ────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ── File storage (S3-compatible, e.g. Cloudflare R2). Required in production for uploads. ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Development only: where the local driver keeps uploads.
LOCAL_STORAGE_DIR=.data/uploads
# Test-only override ("local") used by Playwright against a production build. Leave unset in production.
STORAGE_DRIVER=

# Quotation PDFs (headless Chrome). Locally the installed Google Chrome is found automatically.
# Serverless hosting: set the WebSocket endpoint of a Chrome you control (docs/DEPLOYMENT.md).
CHROME_PATH=
BROWSER_WS_ENDPOINT=
