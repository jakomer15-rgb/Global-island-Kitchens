# Copy to .env.local for local development. Never commit real values.

# Public site origin (canonical URLs, sitemap, structured data). Production: https://<domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number in international digits, e.g. 97334597636. Leave empty to hide the WhatsApp button
# until the owner confirms which number has WhatsApp (docs/OPEN_QUESTIONS.md #8).
NEXT_PUBLIC_WHATSAPP_NUMBER=
