    },
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Other events: ignore",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [760, 300]
    }
  ],
  "connections": {
    "GIK events": { "main": [[{ "node": "Verify signature", "type": "main", "index": 0 }]] },
    "Verify signature": { "main": [[{ "node": "Route by event type", "type": "main", "index": 0 }]] },
    "Route by event type": {
      "main": [
        [{ "node": "Enquiry: replace with your step", "type": "main", "index": 0 }],
        [{ "node": "Lead status: replace with your step", "type": "main", "index": 0 }],
        [{ "node": "Quotation sent: replace with your step", "type": "main", "index": 0 }],
        [{ "node": "Quotation approved: replace with your step", "type": "main", "index": 0 }],
