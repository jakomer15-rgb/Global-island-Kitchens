// Global Island Kitchens: database schema (PostgreSQL 17, Prisma 7). Design: docs/DATA_MODEL.md.
//
// Conventions (database-management skill):
// - snake_case tables and columns via @@map/@map; PascalCase models.
// - Timestamps are timestamptz in UTC; displayed in Asia/Bahrain.
// - Must-hold rules are also database constraints (added by hand in the migration SQL).
// - Business records are archived (`archivedAt`), logs are append-only.
// - Emails are stored lower-cased and phones as E.164 by the service layer.
//
// Phase 4 covers identity, roles, the CRM core, enquiries with uploads, and platform tables.
// Quotations, projects, content, materials and designers arrive in their own phases' migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  ar
}

// ───────────────────────────── Identity and access ─────────────────────────────
// User, Session, Account and Verification follow Better Auth's core schema.

enum UserKind {
  staff
  designer
}

enum UserStatus {
  active
  disabled
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  kind          UserKind   @default(staff)
  status        UserStatus @default(active)
  lastLoginAt   DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           Session[]
  accounts           Account[]
  roles              UserRole[]
  leadsAssigned      Lead[]               @relation("LeadAssignee")
  leadActivities     LeadActivity[]
  followUps          FollowUp[]
  consultations      Consultation[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  settingsUpdated    SiteSetting[]
  filesUploaded      FileAsset[]          @relation("FileUploader")
  materialsVerified  Material[]           @relation("MaterialVerifier")
  blogPosts          BlogPost[]           @relation("BlogAuthor")
  quotationsCreated  Quotation[]          @relation("QuotationCreator")
  quotationsAssigned Quotation[]          @relation("QuotationAssignee")
  revisionsSent      QuotationRevision[]  @relation("RevisionSender")
  approvalsRecorded  QuotationRevision[]  @relation("ApprovalRecorder")
  projectsAssigned   Project[]            @relation("ProjectAssignee")
  stageChanges       ProjectStageChange[]

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Password hash (credential provider). Never selected outside the auth module.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Roles are sets of permissions; system roles can't be deleted. Seeded from src/server/auth/permissions.ts.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  key         String @id
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ───────────────────────────── CRM ─────────────────────────────

enum CustomerType {
  homeowner
  interior_designer
  architect
  developer
  contractor
  business
  other
}

model Customer {
  id                String       @id @default(cuid())
  name              String
  /// E.164, e.g. +97334597636. Unique when present (partial index in migration).
  phone             String?
  /// Lower-cased. Unique when present (partial index in migration).
  email             String?
  type              CustomerType @default(homeowner)
  company           String?
  preferredLanguage Locale       @default(en) @map("preferred_language")
  notes             String?
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads             Lead[]
  consultations     Consultation[]
  quotationRequests QuotationRequest[]
  consents          ConsentRecord[]
  quotations        Quotation[]
  orders            Order[]
  projects          Project[]

  @@index([name])
  @@map("customers")
}

enum LeadSource {
  website_quote
  website_consultation
  website_contact
  designer_portal
  whatsapp
  phone
  walk_in
  referral
  instagram
  other
}

enum LeadStatus {
  new
  contacted
  qualified
  quoted
  won
  lost
}

model Lead {
  id           String     @id @default(cuid())
  /// Shown to the customer, e.g. GIK-Q-2026-00042 (sequence in migration).
  reference    String     @unique
  customerId   String     @map("customer_id")
  source       LeadSource
  /// Product page key from src/config/routes.ts, when known.
  category     String?
  status       LeadStatus @default(new)
  lostReason   String?    @map("lost_reason")
  assignedToId String?    @map("assigned_to_id")
  summary      String
  locale       Locale     @default(en)
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo       User?             @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities       LeadActivity[]
  followUps        FollowUp[]
  consultation     Consultation?
  quotationRequest QuotationRequest?
  quotations       Quotation[]
  projects         Project[]

  @@index([status, createdAt])
  @@index([assignedToId])
  @@map("leads")
}

enum ActivityKind {
  note
  message
  call
  email
  whatsapp
  meeting
  status_change
  assignment
}

/// Communication history and internal notes. Append-only (trigger in migration).
model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String       @map("lead_id")
  kind      ActivityKind
  body      String
  internal  Boolean      @default(true)
  authorId  String?      @map("author_id")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model FollowUp {
  id           String    @id @default(cuid())
  leadId       String    @map("lead_id")
  dueAt        DateTime  @map("due_at") @db.Timestamptz(3)
  assignedToId String?   @map("assigned_to_id")
  note         String?
  doneAt       DateTime? @map("done_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([dueAt, doneAt])
  @@map("follow_ups")
}

enum ConsultationType {
  showroom
  site_visit
  online
}

enum TimeSlot {
  morning
  afternoon
  evening
}

enum ConsultationStatus {
  requested
  confirmed
  completed
  cancelled
  no_show
}

model Consultation {
  id            String             @id @default(cuid())
  leadId        String             @unique @map("lead_id")
  customerId    String             @map("customer_id")
  type          ConsultationType
  preferredDate DateTime           @map("preferred_date") @db.Date
  preferredSlot TimeSlot           @map("preferred_slot")
  /// Site visits only.
  area          String?
  notes         String?
  status        ConsultationStatus @default(requested)
  confirmedAt   DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  assignedToId  String?            @map("assigned_to_id")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([preferredDate, status])
  @@map("consultations")
}

enum ConsentChannel {
  email
  whatsapp
}

/// Marketing consent history. The latest record per customer and channel wins. Append-only.
model ConsentRecord {
  id         String         @id @default(cuid())
  customerId String         @map("customer_id")
  channel    ConsentChannel
  granted    Boolean
  /// Where it was given or withdrawn, e.g. "website_quote", "unsubscribe_link".
  source     String
  ipHash     String?        @map("ip_hash")
  recordedAt DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, channel, recordedAt])
  @@map("consent_records")
}

// ───────────────────────────── Enquiries ─────────────────────────────

enum MeasureUnit {
  mm
  cm
  m
}

enum RequestStatus {
  received
  reviewing
  quoted
  closed
}

model QuotationRequest {
  id              String        @id @default(cuid())
  reference       String        @unique
  leadId          String        @unique @map("lead_id")
  customerId      String        @map("customer_id")
  category        String
  /// [{ label, width, height?, depth? }] validated by src/lib/forms/quote.ts.
  measurements    Json
  unit            MeasureUnit
  /// "egger" | "mdf" | "aluminium" | "unsure"
  preferredBoards String[]      @map("preferred_boards")
  finishNotes     String?       @map("finish_notes")
  message         String?
  area            String?
  status          RequestStatus @default(received)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  files      FileAsset[]
  quotations Quotation[]

  @@index([status, createdAt])
  @@map("quotation_requests")
}

enum FileKind {
  reference_photo
  drawing
  material_image
  project_photo
  blog_image
  quotation_pdf
  other
}

/// Private: customer uploads, served to staff through signed URLs. Public: website images served by /media/[id].
enum FileVisibility {
  private
  public
}

enum FileStatus {
  pending
  verified
  rejected
}

/// Uploaded files. Bytes live in object storage under `storageKey`. Customer uploads are private;
/// website images uploaded by staff are public once attached to published content.
model FileAsset {
  id                 String         @id @default(cuid())
  storageKey         String         @unique @map("storage_key")
  originalName       String         @map("original_name")
  mimeType           String         @map("mime_type")
  sizeBytes          Int            @map("size_bytes")
  kind               FileKind       @default(reference_photo)
  visibility         FileVisibility @default(private)
  status             FileStatus     @default(pending)
  /// Staff member who uploaded a website image.
  uploadedById       String?        @map("uploaded_by_id")
  /// Credit and usage rights, required for website images (no unlicensed photography).
  credit             String?
  /// SHA-256 of the upload ticket handed to the browser; proves the submitter started the upload.
  ticketHash         String?        @map("ticket_hash")
  ipHash             String?        @map("ip_hash")
  quotationRequestId String?        @map("quotation_request_id")
  verifiedAt         DateTime?      @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  quotationRequest QuotationRequest?   @relation(fields: [quotationRequestId], references: [id], onDelete: SetNull)
  uploadedBy       User?               @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  materials        Material[]
  portfolioImages  PortfolioImage[]
  blogCovers       BlogPost[]
  quotationPdfs    QuotationRevision[]

  @@index([status, createdAt])
  @@index([quotationRequestId])
  @@index([visibility, kind])
  @@map("file_assets")
}

// ───────────────────────────── Content (Phase 5) ─────────────────────────────
// Two locales only, so translatable text is stored as En/Ar column pairs.

enum MaterialBoard {
  egger_melamine
  egger_laminate
  painted_mdf
}

enum MaterialAvailability {
  unverified
  in_stock
  to_order
  discontinued
}

/// Materials library: EGGER laminate/melamine décors and painted MDF colours only (owner's rule).
model Material {
  id            String               @id @default(cuid())
  board         MaterialBoard
  /// "EGGER" for EGGER boards, null for painted MDF (CHECK in migration).
  manufacturer  String?
  /// EGGER décor code (e.g. "H1145 ST10") or the paint colour reference.
  code          String
  nameEn        String               @map("name_en")
  nameAr        String?              @map("name_ar")
  descriptionEn String?              @map("description_en")
  descriptionAr String?              @map("description_ar")
  texture       String?
  colourFamily  String?              @map("colour_family")
  /// Approximate swatch colour for display, e.g. "#8b6a4f".
  swatchHex     String?              @map("swatch_hex") @db.Char(7)
  imageFileId   String?              @map("image_file_id")
  availability  MaterialAvailability @default(unverified)
  sortOrder     Int                  @default(0) @map("sort_order")
  /// Public only once checked against EGGER's current collection / the paint reference AND published.
  verifiedAt    DateTime?            @map("verified_at") @db.Timestamptz(3)
  verifiedById  String?              @map("verified_by_id")
  published     Boolean              @default(false)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  image          FileAsset?          @relation(fields: [imageFileId], references: [id], onDelete: SetNull)
  verifiedBy     User?               @relation("MaterialVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  quotationLines QuotationLineItem[]

  @@unique([board, code])
  @@index([published, sortOrder])
  @@map("materials")
}

enum PublishStatus {
  draft
  published
}

/// Customer testimonials. Never invented: publishing requires recorded consent (CHECK in migration).
model Testimonial {
  id                String        @id @default(cuid())
  /// Name as the customer agreed to show it, e.g. "A. Customer, Riffa".
  displayName       String        @map("display_name")
  textEn            String?       @map("text_en")
  textAr            String?       @map("text_ar")
  /// Where it came from, e.g. "Email from the customer, 2026-11-02".
  source            String
  consentNote       String?       @map("consent_note")
  consentRecordedAt DateTime?     @map("consent_recorded_at") @db.Timestamptz(3)
  status            PublishStatus @default(draft)
  sortOrder         Int           @default(0) @map("sort_order")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, sortOrder])
  @@map("testimonials")
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  titleEn     String        @map("title_en")
  titleAr     String?       @map("title_ar")
  excerptEn   String?       @map("excerpt_en")
  excerptAr   String?       @map("excerpt_ar")
  /// Plain text with blank-line paragraphs and "## " headings (rendered safely, no HTML).
  bodyEn      String        @map("body_en")
  bodyAr      String?       @map("body_ar")
  coverFileId String?       @map("cover_file_id")
  status      PublishStatus @default(draft)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  authorId    String?       @map("author_id")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  cover  FileAsset? @relation(fields: [coverFileId], references: [id], onDelete: SetNull)
  author User?      @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("blog_posts")
}

enum PortfolioSegment {
  residential
  villas
  commercial
}

/// Website portfolio. Seeded from the company profile; client names shown only with permission.
model PortfolioProject {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  segment              PortfolioSegment
  nameEn               String           @map("name_en")
  nameAr               String           @map("name_ar")
  locationEn           String           @map("location_en")
  locationAr           String           @map("location_ar")
  sizeEn               String?          @map("size_en")
  sizeAr               String?          @map("size_ar")
  scopeEn              String           @map("scope_en")
  scopeAr              String           @map("scope_ar")
  /// kitchens, closets, bedSets, tvUnits, vanities, doors, cladding, fullJoinery, furnished, commercial
  scopeTags            String[]         @map("scope_tags")
  clientName           String?          @map("client_name")
  clientNamePermission Boolean          @default(false) @map("client_name_permission")
  featured             Boolean          @default(false)
  published            Boolean          @default(true)
  sortOrder            Int              @default(0) @map("sort_order")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  images PortfolioImage[]

  @@index([published, segment, sortOrder])
  @@map("portfolio_projects")
}

/// A project photo. Shown only when the company confirms it may be used (CHECK in migration).
model PortfolioImage {
  id              String   @id @default(cuid())
  projectId       String   @map("project_id")
  fileId          String   @map("file_id")
  altEn           String   @map("alt_en")
  altAr           String   @map("alt_ar")
  usagePermission Boolean  @default(false) @map("usage_permission")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file    FileAsset        @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([projectId, sortOrder])
  @@map("portfolio_images")
}

// ───────────────────────────── Platform ─────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

enum OutboxStatus {
  pending
  processing
  done
  failed
}

/// Side effects (emails, n8n webhooks) written in the same transaction as the business change.
model OutboxEvent {
  id            String       @id @default(cuid())
  type          String
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt      DateTime?    @map("locked_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  /// What each delivery channel did, e.g. { "staffEmail": "sent", "n8n": "not_configured" }.
  result        Json?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

/// Append-only (trigger in migration). IPs are stored only as keyed hashes.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimitBucket {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

/// Editable settings (contact details, hours, VAT, SEO defaults, feature flags). Value validated per key.
model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

// ─── Phase 6: quotations, orders, projects ──────────────────────────────────
// Money is integer fils (1 BHD = 1000 fils). Totals are checked by the database.

enum QuotationStatus {
  draft
  sent
  approved
  rejected
  converted
}

enum LineItemKind {
  product
  material
  hardware
  labour
  installation
  other
}

enum LineUnit {
  unit
  set
  linear_metre
  square_metre
}

enum ApprovalMethod {
  whatsapp
  phone
}

model Quotation {
  id             String          @id @default(cuid())
  /// GIK-QT-2026-00001 (sequence in migration).
  number         String          @unique
  customerId     String          @map("customer_id")
  leadId         String?         @map("lead_id")
  requestId      String?         @map("request_id")
  title          String
  /// Language of the quotation document.
  locale         Locale          @default(en)
  status         QuotationStatus @default(draft)
  rejectedReason String?         @map("rejected_reason")
  createdById    String?         @map("created_by_id")
  assignedToId   String?         @map("assigned_to_id")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead       Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  request    QuotationRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdBy  User?               @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?               @relation("QuotationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  revisions  QuotationRevision[]

  @@index([status, updatedAt])
  @@index([customerId])
  @@map("quotations")
}

model QuotationRevision {
  id                   String          @id @default(cuid())
  quotationId          String          @map("quotation_id")
  revision             Int
  subtotalFils         BigInt          @default(0) @map("subtotal_fils")
  discountFils         BigInt          @default(0) @map("discount_fils")
  /// 1000 = 10%. 0 when the company doesn't charge VAT.
  vatRateBasisPoints   Int             @default(0) @map("vat_rate_basis_points")
  vatFils              BigInt          @default(0) @map("vat_fils")
  totalFils            BigInt          @default(0) @map("total_fils")
  /// VAT registration number printed on the document (copied from settings when sent).
  vatNumber            String?         @map("vat_number")
  validUntil           DateTime?       @map("valid_until") @db.Date
  notes                String?
  terms                String?
  sentAt               DateTime?       @map("sent_at") @db.Timestamptz(3)
  sentById             String?         @map("sent_by_id")
  /// Sent revisions are locked: line items and totals can't change (trigger in migration).
  lockedAt             DateTime?       @map("locked_at") @db.Timestamptz(3)
  pdfFileId            String?         @map("pdf_file_id")
  approvedAt           DateTime?       @map("approved_at") @db.Timestamptz(3)
  approvalMethod       ApprovalMethod? @map("approval_method")
  /// Who approved for the customer and any detail, e.g. "Mrs A. by WhatsApp, message kept".
  approvalNote         String?         @map("approval_note")
  approvalRecordedById String?         @map("approval_recorded_by_id")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  quotation          Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sentBy             User?               @relation("RevisionSender", fields: [sentById], references: [id], onDelete: SetNull)
  approvalRecordedBy User?               @relation("ApprovalRecorder", fields: [approvalRecordedById], references: [id], onDelete: SetNull)
  pdf                FileAsset?          @relation(fields: [pdfFileId], references: [id], onDelete: SetNull)
  lines              QuotationLineItem[]
  order              Order?

  @@unique([quotationId, revision])
  @@map("quotation_revisions")
}

model QuotationLineItem {
  id            String       @id @default(cuid())
  revisionId    String       @map("revision_id")
  sortOrder     Int          @default(0) @map("sort_order")
  kind          LineItemKind @default(product)
  description   String
  materialId    String?      @map("material_id")
  widthMm       Int?         @map("width_mm")
  heightMm      Int?         @map("height_mm")
  depthMm       Int?         @map("depth_mm")
  unit          LineUnit     @default(unit)
  /// Quantity × 1000 (3 decimal places), e.g. 2.5 m = 2500.
  quantityMilli Int          @map("quantity_milli")
  unitPriceFils BigInt       @map("unit_price_fils")
  lineTotalFils BigInt       @map("line_total_fils")

  revision QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  material Material?         @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([revisionId, sortOrder])
  @@map("quotation_line_items")
}

enum OrderStatus {
  confirmed
  in_production
  installed
  completed
  cancelled
}

model Order {
  id                  String      @id @default(cuid())
  /// GIK-OR-2026-00001 (sequence in migration).
  number              String      @unique
  quotationRevisionId String      @unique @map("quotation_revision_id")
  customerId          String      @map("customer_id")
  totalFils           BigInt      @map("total_fils")
  /// Agreed deposit, entered by staff (no default: terms aren't known).
  depositFils         BigInt?     @map("deposit_fils")
  depositReceivedAt   DateTime?   @map("deposit_received_at") @db.Timestamptz(3)
  status              OrderStatus @default(confirmed)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  revision QuotationRevision @relation(fields: [quotationRevisionId], references: [id], onDelete: Restrict)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project  Project?

  @@index([status, createdAt])
  @@map("orders")
}

enum ProjectStage {
  inquiry
  measurement
  design
  quotation
  approval
  production
  installation
  completion
}

model Project {
  id           String       @id @default(cuid())
  /// GIK-PR-2026-00001 (sequence in migration).
  reference    String       @unique
  customerId   String       @map("customer_id")
  leadId       String?      @map("lead_id")
  orderId      String?      @unique @map("order_id")
  title        String
  siteAddress  String?      @map("site_address")
  stage        ProjectStage @default(inquiry)
  assignedToId String?      @map("assigned_to_id")
  targetDate   DateTime?    @map("target_date") @db.Date
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead         Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedTo   User?                @relation("ProjectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  stageChanges ProjectStageChange[]

  @@index([stage, updatedAt])
  @@map("projects")
}

model ProjectStageChange {
  id          String        @id @default(cuid())
  projectId   String        @map("project_id")
  fromStage   ProjectStage? @map("from_stage")
  toStage     ProjectStage  @map("to_stage")
  changedById String?       @map("changed_by_id")
  note        String?
  changedAt   DateTime      @default(now()) @map("changed_at") @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([projectId, changedAt])
  @@map("project_stage_changes")
}
